# EZVeploy server configuration — copy to .env on the VPS and edit.
# Run the server with: node src/index.js --env-file=.env (from server/)

# --- auth (required — the panel runs as root; make this long and random) ---
ADMIN_USER=admin
# generate with: openssl rand -base64 24
ADMIN_PASSWORD=change-me

# --- listen ---
# Keep 127.0.0.1 and terminate TLS at a reverse proxy (nginx/caddy).
HOST=127.0.0.1
PORT=3900

# --- runtime data (domain registry) ---
DATA_DIR=./data

# --- the provisioning script, which lives ON THE VPS (NOT in this repo) ---
# Contract: <script> <domain> <user> · exit 0 = success · stdout = summary
# Example: /opt/ezveploy/provision-domain.sh
PROVISION_SCRIPT=/opt/ezveploy/provision-domain.sh

# --- tenants to hide from the panel (comma-separated) ---
USER_BLOCKLIST=

# --- overrides used by the test suite; leave unset in production ---
# DOCKER_BIN=docker
# PASSWD_FILE=/etc/passwd