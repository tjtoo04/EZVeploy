# EZVeploy VPS agent — copy to agent/.env on the VPS and edit.
# Runs as root. Talks to the per-user docker daemon sockets, reads /etc/passwd,
# and executes the provisioning script. Nothing else talks to it but the API
# server, over http://127.0.0.1:3901.
# Run with: node src/index.js --env-file=.env (from agent/, or `npm start`)

# --- service token (required — must match AGENT_TOKEN in server/.env) ---
# generate with: openssl rand -base64 24
AGENT_TOKEN=change-me

# --- listen ---
# Internal only — the API server is the only caller.
HOST=127.0.0.1
PORT=3901

# --- the provisioning script, which lives ON THE VPS (NOT in this repo) ---
# Contract: <script> <domain> <user> · exit 0 = success · stdout = summary
# Example: /opt/ezveploy/provision-domain.sh
PROVISION_SCRIPT=/opt/ezveploy/provision-domain.sh

# --- tenants to hide from the panel (comma-separated) ---
USER_BLOCKLIST=

# --- overrides used by the test suite / dev fixtures; leave unset in production ---
# DOCKER_BIN=docker
# PASSWD_FILE=/etc/passwd