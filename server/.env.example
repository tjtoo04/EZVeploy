# EZVeploy API server — copy to server/.env on the VPS and edit.
# A pure HTTP gateway: Basic auth, the domain registry, the built UI. Every
# OS operation is delegated to the VPS agent (see agent/.env.example).
# Run with: node src/index.js --env-file=.env (from server/, or `npm start`)

# --- auth (required — the panel runs as root; make this long and random) ---
ADMIN_USER=admin
# generate with: openssl rand -base64 24
ADMIN_PASSWORD=change-me

# --- listen ---
# Keep 127.0.0.1 and terminate TLS at a reverse proxy (nginx/caddy).
HOST=127.0.0.1
PORT=3900

# --- the VPS agent (server/ talks to agent/ over localhost) ---
AGENT_URL=http://127.0.0.1:3901
# generate with: openssl rand -base64 24 — must equal AGENT_TOKEN in agent/.env
AGENT_TOKEN=change-me

# --- runtime data (domain registry) ---
DATA_DIR=./data